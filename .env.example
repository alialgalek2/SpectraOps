# Fleet Hub Configuration

# Database driver: 'sqlite' (zero config for dev/test) or 'mysql' (production)
DB_CONNECTION=sqlite

# MySQL / MariaDB Production Settings
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=central_fleet_db
DB_USERNAME=fleet_user
DB_PASSWORD=CHANGE_ME_TO_A_STRONG_DATABASE_PASSWORD
DB_CHARSET=utf8mb4

# SQLite Local Database (used when DB_CONNECTION=sqlite)
# DB_DATABASE=/path/to/fleet.sqlite

# Security & Alerting
ALERT_EMAIL=devops@yourcompany.com
STALE_HEARTBEAT_HOURS=2
RETENTION_DAYS=60

# Support Notification Settings
ADMIN_ALERT_EMAIL="your-personal-email@domain.com"

# SMTP Provider (Mailgun, SendGrid, Amazon SES, or Custom Server)
SMTP_HOST="smtp.mailgun.org"
SMTP_PORT=587
SMTP_USER="postmaster@yourcentraldomain.com"
SMTP_PASS="YOUR_SMTP_PASSWORD"
SMTP_FROM="alerts@yourcentraldomain.com"

# AI Diagnostic & Root-Cause Analysis
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_MODEL="gemini-3.8-flash"

# E-Commerce Webhook & Order Provisioning
SPECTRAOPS_WEBHOOK_SECRET="CHANGE_ME_TO_A_CRYPTOGRAPHICALLY_SECURE_WEBHOOK_SECRET"
