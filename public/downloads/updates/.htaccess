# SpectraOps OTA Update Storage Security Configuration
# Prevent directory browsing / indexing
Options -Indexes -ExecCGI

# Prevent execution of any server-side scripts in this directory
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

# Remove script handlers to prevent execution via handler overrides
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .cgi .pl .py .sh
RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8 .cgi .pl .py .sh

# Block direct web access to executable files, dotfiles, and sensitive configuration
<FilesMatch "(?i:\.(php|phtml|php3|php4|php5|php7|php8|phar|inc|cgi|pl|py|sh|bash|exe|bat|cmd|env|git|htaccess|htpasswd))$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Deny,Allow
        Deny from all
    </IfModule>
</FilesMatch>

# Only permit legitimate update package archives
<FilesMatch "(?i:\.(zip|tar|gz|tgz|sig|json|sha256))$">
    <IfModule mod_authz_core.c>
        Require all granted
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Allow,Deny
        Allow from all
    </IfModule>
    ForceType application/octet-stream
</FilesMatch>
